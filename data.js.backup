        {
            name: "Reading Practice",
            easy: [
                "I work in an office. I meet clients.",
                "She manages the team. She leads meetings.",
                "We send emails. We write reports.",
                "He calls customers. He solves problems.",
                "They train staff. They teach skills.",
                "I attend conferences. I learn new things.",
                "She reviews contracts. She signs documents.",
                "We discuss projects. We make decisions.",
                "He interviews candidates. He hires people.",
                "They set deadlines. They meet targets.",
                "I prepare presentations. I speak publicly.",
