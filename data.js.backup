        {
            name: "Thought Groups",
            easy: [
                "I study science. / She teaches math. / We learn together. / Knowledge is power.",
                "He reads books. / They do homework. / I take notes. / School is important.",
                "We attend class. / She asks questions. / He gives answers. / Learning is fun.",
