    "Word Stress Patterns": {
        title: "Word Stress Patterns",
        description: "Practice identifying and producing correct stress patterns in words. Capital letters show which syllable to emphasize (e.g., BREAKfast, toMOrrow). Proper word stress is essential for being understood by native speakers."
    },
    "Linking Sounds": {
        title: "Linking Sounds",
        description: "Practice connecting words smoothly when speaking. The underscore (_) shows where sounds link together (e.g., check_in, wake_up). This technique helps you sound more fluent and natural, like native speakers do."
    },
    "Contractions Practice": {
        title: "Contractions Practice",
        description: "Practice pronouncing common English contractions correctly. The IPA symbols (between / /) show the exact pronunciation (e.g., I'm → /aɪm/). Mastering contractions is crucial for natural, conversational English."
    },
    "Silent Letters": {
        title: "Silent Letters",
        description: "Practice words with silent letters that are not pronounced. Letters in parentheses are silent (e.g., k(nife), w(rite)). Knowing which letters to skip helps avoid common pronunciation mistakes."
    },
    "Over-Articulation": {
        title: "Over-Articulation",
        description: "Practice exaggerating each word's pronunciation. Speak slowly and deliberately, focusing on clear articulation of every syllable. This technique helps train your mouth muscles and improves clarity."
    },
    "Tongue Twisters": {
        title: "Tongue Twisters",
        description: "Challenging phrases designed to improve pronunciation agility and fluency. Start slowly, then gradually increase speed. Focus on accuracy first, speed second. These help with difficult sound combinations."
    },
    "Minimal Pairs Training": {
        title: "Minimal Pairs Training",
        description: "Practice distinguishing between similar sounds. Say both words out loud, focusing on the subtle differences shown in the phonetic transcription (symbols between / /). This trains your ear and mouth to recognize and produce distinct sounds."
    },
    "Chunking (Natural Blocks)": {
        title: "Chunking (Natural Blocks)",
        description: "Learn to speak in natural rhythm by breaking sentences into meaningful chunks. Pause at the slashes (/) to practice natural speech patterns. This improves fluency and makes your English sound more native."
    },
    "Stress and Intonation": {
        title: "Stress and Intonation",
        description: "Practice emphasizing key words in sentences. Words in BOLD should be stressed (spoken louder/stronger). This technique teaches natural English rhythm and helps convey meaning effectively. Native speakers use stress to highlight important information."
    },
    "Thought Groups": {
        title: "Thought Groups",
        description: "Practice reading sentences and paragraphs divided into logical thought units. Pause briefly at each slash (/) to separate ideas. This technique builds natural speaking rhythm for longer statements and improves listener comprehension."
    },
    "Reading Practice": {
        title: "Reading Practice",
        description: "Read complete paragraphs and texts aloud to build fluency and confidence. Start with shorter texts and progress to longer ones. Focus on smooth delivery, natural pacing, and clear pronunciation throughout. This technique integrates all pronunciation skills."
    }
};

