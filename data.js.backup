// Grammar Tenses Explanations
const tenseExplanations = {
    "Present Simple": {
        title: "Present Simple",
        description: "Use for habits, routines, facts, and general truths. Examples: 'I work every day', 'The sun rises in the east'."
    },
    "Present Continuous": {
        title: "Present Continuous",
        description: "Use for actions happening right now or temporary situations. Examples: 'I am working now', 'She is studying this week'."
    },
    "Present Perfect": {
        title: "Present Perfect",
        description: "Use for actions that happened at an unspecified time or have relevance to now. Examples: 'I have finished', 'She has lived here for years'."
    },
    "Present Perfect Continuous": {
        title: "Present Perfect Continuous",
        description: "Use for actions that started in the past and continue now, emphasizing duration. Examples: 'I have been working all day', 'She has been studying for hours'."
    },
    "Past Simple": {
        title: "Past Simple",
        description: "Use for completed actions at a specific time in the past. Examples: 'I worked yesterday', 'She finished last night'."
    },
    "Past Continuous": {
        title: "Past Continuous",
        description: "Use for actions in progress at a specific moment in the past. Examples: 'I was working when you called', 'They were studying at 8pm'."
    },
    "Past Perfect": {
        title: "Past Perfect",
        description: "Use for actions completed before another past action. Examples: 'I had finished before they arrived', 'She had left when I got there'."
    },
    "Past Perfect Continuous": {
        title: "Past Perfect Continuous",
        description: "Use for ongoing actions before another past action, emphasizing duration. Examples: 'I had been working for hours before the meeting'."
    },
    "Future Simple": {
        title: "Future Simple",
        description: "Use for predictions, spontaneous decisions, and future facts. Examples: 'I will help you', 'It will rain tomorrow'."
    },
    "Future Continuous": {
        title: "Future Continuous",
        description: "Use for actions that will be in progress at a specific future time. Examples: 'I will be working at 5pm', 'They will be traveling next week'."
    },
    "Future Perfect": {
        title: "Future Perfect",
        description: "Use for actions that will be completed before a specific future time. Examples: 'I will have finished by noon', 'She will have left by then'."
    },
    "Future Perfect Continuous": {
        title: "Future Perfect Continuous",
        description: "Use for ongoing actions up to a specific future time, emphasizing duration. Examples: 'I will have been working here for 5 years'."
    }
};

